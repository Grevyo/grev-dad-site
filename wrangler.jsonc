{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "grev-dad-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": { "APP_ENV": "development" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "grev-dad-dev",
    "database_id": "REPLACE_WITH_DEV_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }],
  "env": {
    "preview": {
      "name": "grev-dad-preview",
      "vars": { "APP_ENV": "preview" },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "grev-dad-preview",
        "database_id": "REPLACE_WITH_PREVIEW_D1_DATABASE_ID",
        "migrations_dir": "migrations"
      }]
    },
    "production": {
      "name": "grev-dad",
      "vars": { "APP_ENV": "production" },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "grev-dad-production",
        "database_id": "REPLACE_WITH_PRODUCTION_D1_DATABASE_ID",
        "migrations_dir": "migrations"
      }]
    }
  }
}
