{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grev-dad-site",
  "main": "src/index.js",
  "compatibility_date": "2026-05-02",
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "profile-db",
      "database_id": "PASTE_REAL_DATABASE_ID_HERE",
      "migrations_dir": "migrations"
    }
  ]
}
