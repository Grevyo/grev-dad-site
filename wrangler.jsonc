{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grev-dad-site",
  "main": "src/index.js",
  "compatibility_date": "2026-03-21",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "DB",
      "database_id": "4e1a3548-6316-4a9b-926f-f536b4a6d5a6"
    }
  ]
}
